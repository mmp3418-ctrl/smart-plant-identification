VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Asset public path: `/` on Vercel (auto when VERCEL=1), GH Pages subpath otherwise.
# Override if needed, e.g. VITE_BASE_PATH=/
# VITE_BASE_PATH=/

# Server-only (Vercel → Settings → Environment Variables). Never use VITE_ for this.
PLANTNET_API_KEY=

# Local `npm run dev` only — used by Vite server proxy, not bundled into the client
# (prefer PLANTNET_API_KEY above)
# VITE_PLANTNET_API_KEY=
