VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Asset public path: `/` on Vercel (auto when VERCEL=1), GH Pages subpath otherwise.
# Override if needed, e.g. VITE_BASE_PATH=/
# VITE_BASE_PATH=/

# Server-only. Used by Vercel `api/identify.js` and the local Vite `/api/identify` proxy.
# Never prefix with VITE_ — that would ship the key to the browser.
PLANTNET_API_KEY=
