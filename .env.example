VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Asset public path: `/` on Vercel (auto when VERCEL=1), GH Pages subpath otherwise.
# Override if needed, e.g. VITE_BASE_PATH=/
# VITE_BASE_PATH=/

# Optional: override the identify proxy URL (default `/api/identify`)
# VITE_IDENTIFY_API_URL=/api/identify

# Server-only (Vercel Environment Variable — NOT prefixed with VITE_)
# Set this in the Vercel dashboard for production:
PLANTNET_API_KEY=

# Optional local-dev fallback used by Vite proxy in vite.config.ts
VITE_PLANTNET_API_KEY=
